# Runtime
APP_ENV=local
# local | gcp | aws — selects the adapter set once APP_ENV is not local.
CLOUD_PROVIDER=local
LOCAL_POLICY_PATH=policies/credit_policy_v1.json
MAX_BATCH_SIZE=1000

# Table names are shared by both clouds (BigQuery tables / Glue tables).
BIGQUERY_DATASET=credit_policy
BIGQUERY_INPUT_TABLE=applicants
BIGQUERY_OUTPUT_TABLE=scoring_results
BIGQUERY_RUNS_TABLE=scoring_runs
POLICY_ACTIVE_OBJECT=policies/active.json

# Google Cloud
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
BIGQUERY_LOCATION=US
POLICY_BUCKET=your-project-id-credit-policy-studio
# Set this on the UI service to invoke a deployed Vertex endpoint.
VERTEX_ENDPOINT_ID=

# AWS
AWS_REGION=us-east-1
# POLICY_BUCKET is shared: set it to the S3 bucket name when CLOUD_PROVIDER=aws.
DATA_BUCKET=credit-policy-studio-data-000000000000
GLUE_DATABASE=credit_policy
ATHENA_WORKGROUP=credit-policy-studio
ATHENA_OUTPUT_URI=
# Set this on the UI to invoke a deployed SageMaker endpoint.
SAGEMAKER_ENDPOINT_NAME=
